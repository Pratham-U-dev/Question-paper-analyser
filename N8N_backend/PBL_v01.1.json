      "parameters": {
        "jsCode": "const questions = $node[\"Supabase Questions\"].all().map(i => i.json);\nconst papers = $node[\"Supabase Papers\"].all().map(i => i.json);\n\nconst avgMarks = questions.length ? questions.reduce((sum, q) => sum + (q.marks || 0), 0) / questions.length : 0;\n\nreturn { \n  json: {\n    total_papers: papers.length,\n    total_questions: questions.length,\n    avg_marks: Math.round(avgMarks * 100) / 100\n  }\n};"
