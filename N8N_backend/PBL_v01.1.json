    {
      "parameters": {
        "jsCode": "const webhookData = $node[\"Webhook\"].json.body; \n\nlet aiText = \"\";\nif (Array.isArray($input.item.json) && $input.item.json[0]?.content) {\n    aiText = $input.item.json[0].content.parts[0].text;\n} else if ($input.item.json.content?.parts) {\n    aiText = $input.item.json.content.parts[0].text;\n} else {\n    aiText = $input.item.json.text || $input.item.json.output || \"\";\n}\n\naiText = aiText.replace(/```json/g, '').replace(/```/g, '').trim();\nconst parsedResult = JSON.parse(aiText);\n\nreturn {\n  json: {\n    institution_name: parsedResult.institution_header ? parsedResult.institution_header[0] : null,\n    examination_name: parsedResult.exam_details?.examination_name || null,\n    subject_name: parsedResult.exam_details?.subject || null,\n    subject_code: webhookData.subject_code || null,\n    exam_year: parseInt(webhookData.exam_year) || null,\n    paper_type: webhookData.paper_type || null,\n    duration: parsedResult.exam_details?.duration || null,\n    maximum_marks: parseInt(String(parsedResult.exam_details?.maximum_marks).replace(/\\D/g, '')) || null,\n    upload_role: webhookData.role || null\n  }\n};\n// Now this node ONLY outputs database columns! Auto-map will work perfectly.\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        -144
      ],
      "id": "78958295-ff53-4544-99ac-786598e8ed2b",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const paperId = $input.item.json.id; \nconst subjectCode = $node[\"Webhook\"].json.body.subject_code;\n\n// NOTICE the exact lowercase 'd' here to match your setup exactly!\nconst geminiData = $node[\"Analyze document\"].json;\n\nlet aiText = \"\";\nif (Array.isArray(geminiData) && geminiData[0]?.content) {\n    aiText = geminiData[0].content.parts[0].text;\n} else if (geminiData.content?.parts) {\n    aiText = geminiData.content.parts[0].text;\n} else {\n    aiText = geminiData.text || geminiData.output || \"\";\n}\n\naiText = aiText.replace(/```json/g, '').replace(/```/g, '').trim();\nconst aiData = JSON.parse(aiText);\n\nlet dbQuestions = [];\n\nconst processQuestion = (q, part, moduleTitle) => {\n  if(!q.Question) return;\n  dbQuestions.push({\n    paper_id: paperId,\n    subject_code: subjectCode,\n    part: part,\n    module: moduleTitle || null,\n    q_no: q[\"Q.No.\"] || null,\n    sub_question: q.sub_question || null,\n    question_text: q.Question,\n    blooms_level: parseInt(String(q.BL).replace(/\\D/g, '')) || null,\n    course_outcome: q.CO || null,\n    program_outcome: q.PO || null,\n    marks: parseInt(q.Marks) || null\n  });\n};\n\nif (aiData.questions_table?.questions) {\n  aiData.questions_table.questions.forEach(q => processQuestion(q, 'General', null));\n}\nif (aiData.part_a?.questions) {\n  aiData.part_a.questions.forEach(q => processQuestion(q, 'Part-A', null));\n}\nif (aiData.part_b?.modules) {\n  aiData.part_b.modules.forEach(mod => {\n    mod.rows.forEach(q => processQuestion(q, 'Part-B', mod.heading));\n  });\n}\n\nreturn dbQuestions.map(item => ({ json: item })); \n"
      },
